LLM_API_KEY=your_key_here

# Optional API settings. The defaults are safe for local development.
# HAQDAR_ENV=production              turns off /docs and /openapi.json
# HAQDAR_ALLOWED_ORIGINS=https://your-site.example   comma-separated list of web app addresses
# HAQDAR_TRUST_PROXY=0               set to 1 only behind a reverse proxy you control
# HAQDAR_HSTS=0                      set to 1 once the site is served over HTTPS
# HAQDAR_RATE_WRITE=20               POST requests per minute per client
# HAQDAR_RATE_READ=60                GET requests per minute per client
# HAQDAR_MAX_BODY_BYTES=65536

# Optional settings. Copy to .env and change what you need. No API keys are needed.
HAQDAR_ENV=development
HAQDAR_AI_MODE=real
HAQDAR_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500